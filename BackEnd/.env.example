PORT=5000
MONGO_URI=mongodb://localhost:27017/hospital_mgmt
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=24h
FRONTEND_URL=http://localhost:5173

# Admin seed
ADMIN_SEED_EMAIL=admin@ayurvedahealth.com
ADMIN_SEED_MOBILE=9876543210
ADMIN_SEED_PASSWORD=Admin@123

# OTP (forgot password)
STATIC_OTP=1122
OTP_EXPIRY_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=30

# ═══════════════════════════════════════════════════════════════
# MSG91 — SMS only (DLT Flow API)
# ═══════════════════════════════════════════════════════════════
MSG91_ENABLED=true
MSG91_AUTH_KEY=your_msg91_auth_key

# ═══════════════════════════════════════════════════════════════
# 1) OTP — Forgot password / login OTP (SMS)
# ═══════════════════════════════════════════════════════════════
MSG91_TEMPLATE_ID=your_otp_dlt_template_id
MSG91_OTP_VARIABLE=OTP

# ═══════════════════════════════════════════════════════════════
# 2) APPOINTMENT REMINDER — ~1 hr before visit (SMS)
# ═══════════════════════════════════════════════════════════════
MSG91_APPOINTMENT_TEMPLATE_ID=your_appointment_dlt_template_id
MSG91_APPT_VAR_PATIENT=PATIENT
MSG91_APPT_VAR_DOCTOR=DOCTOR
MSG91_APPT_VAR_DATE=DATE
MSG91_APPT_VAR_TIME=TIME

# ═══════════════════════════════════════════════════════════════
# 3) FOLLOW-UP REMINDER — ~1 hr before follow-up (SMS)
# ═══════════════════════════════════════════════════════════════
MSG91_FOLLOWUP_TEMPLATE_ID=your_followup_dlt_template_id
MSG91_FOLLOWUP_VAR_PATIENT=PATIENT
MSG91_FOLLOWUP_VAR_DOCTOR=DOCTOR
MSG91_FOLLOWUP_VAR_DATE=DATE
MSG91_FOLLOWUP_VAR_TIME=TIME

# ═══════════════════════════════════════════════════════════════
# FOXGLOVE — WhatsApp (Pinbot / Meta Cloud API)
# Dashboard: Foxgloveconnect → WhatsApp → Templates
# Docs: BackEnd/docs/FOXGLOVE_WHATSAPP_INTEGRATION.md
# ═══════════════════════════════════════════════════════════════
FOXGLOVE_WA_ENABLED=true
# API key from Foxglove dashboard (sent as header: apikey)
FOXGLOVE_WA_API_KEY=your_foxglove_api_key
# Phone number ID from messages URL, e.g. 801882889676923
# POST https://partnersv1.pinbot.ai/v3/{PHONE_NUMBER_ID}/messages
FOXGLOVE_WA_PHONE_NUMBER_ID=801882889676923
FOXGLOVE_WA_BASE_URL=https://partnersv1.pinbot.ai/v3
FOXGLOVE_WA_LANGUAGE_CODE=en
# Recipient format: 10-digit local (default) or intl (91XXXXXXXXXX)
# FOXGLOVE_WA_TO_FORMAT=intl

# --- 1) OTP on WhatsApp (utility / authentication template) ---
# Template name = lowercase_with_underscores as in Foxglove (e.g. otp_login)
FOXGLOVE_WA_OTP_TEMPLATE_NAME=your_otp_whatsapp_template
# Optional copy-code button on auth template
# FOXGLOVE_WA_OTP_BUTTON_ENABLED=true
# FOXGLOVE_WA_OTP_BUTTON_TYPE=copy_code

# --- 2) Appointment reminder on WhatsApp ---
# Body vars order: {{1}} patient, {{2}} doctor, {{3}} date, {{4}} time
FOXGLOVE_WA_APPOINTMENT_TEMPLATE_NAME=your_appointment_wa_template

# --- 3) Follow-up reminder on WhatsApp ---
FOXGLOVE_WA_FOLLOWUP_TEMPLATE_NAME=your_followup_wa_template

# ═══════════════════════════════════════════════════════════════
# REMINDER JOB — when to send (applies to SMS + WhatsApp)
# ═══════════════════════════════════════════════════════════════
SMS_REMINDER_ENABLED=true
SMS_REMINDER_MINUTES_BEFORE=60
SMS_REMINDER_WINDOW_MINUTES=2
SMS_REMINDER_POLL_INTERVAL_MS=60000

# Cloudinary (prescription PDFs — folder HMS/admin/{patient}/prescription)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ═══════════════════════════════════════════════════════════════
# RAZORPAY — Online payments (billing)
# Dashboard: https://dashboard.razorpay.com/app/keys
# Webhook URL: POST {BACKEND_URL}/api/admin/billing/razorpay/webhook
# Webhook events: payment.captured, order.paid, qr_code.credited
# ═══════════════════════════════════════════════════════════════
RAZORPAY_ENABLED=true
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Full setup & testing guide: BackEnd/docs/RAZORPAY_BILLING_INTEGRATION.md
