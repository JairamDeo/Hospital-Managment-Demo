PORT=5000
# Atlas URI required on Vercel (allow network access from 0.0.0.0/0 or Vercel IPs)
MONGO_URI=mongodb://localhost:27017/hospital_mgmt
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=24h
# Local: http://localhost:5173 | Vercel: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# ─── Vercel (Project → Settings → Environment Variables) ───
# Set framework to "Services". Copy secrets from this file into Vercel.
# Required on Vercel: MONGO_URI, JWT_SECRET, FRONTEND_URL
# Frontend build var: VITE_BACKEND_URL=/api  (same-origin via vercel.json rewrites)
# Optional: NODE_ENV=production
# After deploy, set Razorpay webhook to: https://your-app.vercel.app/api/admin/billing/razorpay/webhook

# Admin seed
ADMIN_SEED_EMAIL=admin@ayurvedahealth.com
ADMIN_SEED_MOBILE=9876543210
ADMIN_SEED_PASSWORD=Admin@123

# OTP (forgot password)
STATIC_OTP=1122
OTP_EXPIRY_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=30

# ═══════════════════════════════════════════════════════════════
# MSG91 — SMS only (DLT Flow API)
# ═══════════════════════════════════════════════════════════════
MSG91_ENABLED=true
MSG91_AUTH_KEY=your_msg91_auth_key

# ═══════════════════════════════════════════════════════════════
# 1) OTP — Forgot password / login OTP (SMS)
# ═══════════════════════════════════════════════════════════════
MSG91_TEMPLATE_ID=your_otp_dlt_template_id
MSG91_OTP_VARIABLE=OTP

# ═══════════════════════════════════════════════════════════════
# 2) APPOINTMENT REMINDER — ~1 hr before visit (SMS)
# ═══════════════════════════════════════════════════════════════
MSG91_APPOINTMENT_TEMPLATE_ID=your_appointment_dlt_template_id
MSG91_APPT_VAR_PATIENT=PATIENT
MSG91_APPT_VAR_DOCTOR=DOCTOR
MSG91_APPT_VAR_DATE=DATE
MSG91_APPT_VAR_TIME=TIME

# ═══════════════════════════════════════════════════════════════
# 3) FOLLOW-UP REMINDER — ~1 hr before follow-up (SMS)
# ═══════════════════════════════════════════════════════════════
MSG91_FOLLOWUP_TEMPLATE_ID=your_followup_dlt_template_id
MSG91_FOLLOWUP_VAR_PATIENT=PATIENT
MSG91_FOLLOWUP_VAR_DOCTOR=DOCTOR
MSG91_FOLLOWUP_VAR_DATE=DATE
MSG91_FOLLOWUP_VAR_TIME=TIME

# ═══════════════════════════════════════════════════════════════
# 4) PAYMENT LINK — Collect payment SMS (Razorpay link to patient)
# DLT example: Dear ##PATIENT##, pay ##AMOUNT## for invoice ##INVOICE##: ##LINK## - Arogya Hospital
# ═══════════════════════════════════════════════════════════════
MSG91_PAYMENT_LINK_TEMPLATE_ID=your_payment_link_dlt_template_id
MSG91_PAYLINK_VAR_PATIENT=PATIENT
MSG91_PAYLINK_VAR_AMOUNT=AMOUNT
MSG91_PAYLINK_VAR_INVOICE=INVOICE
MSG91_PAYLINK_VAR_LINK=LINK

# ═══════════════════════════════════════════════════════════════
# FOXGLOVE — WhatsApp (Pinbot / Meta Cloud API)
# Dashboard: Foxgloveconnect → WhatsApp → Templates
# Docs: BackEnd/docs/FOXGLOVE_WHATSAPP_INTEGRATION.md
# ═══════════════════════════════════════════════════════════════
FOXGLOVE_WA_ENABLED=true
# API key from Foxglove dashboard (sent as header: apikey)
FOXGLOVE_WA_API_KEY=your_foxglove_api_key
# Phone number ID from messages URL, e.g. 801882889676923
# POST https://partnersv1.pinbot.ai/v3/{PHONE_NUMBER_ID}/messages
FOXGLOVE_WA_PHONE_NUMBER_ID=801882889676923
FOXGLOVE_WA_BASE_URL=https://partnersv1.pinbot.ai/v3
FOXGLOVE_WA_LANGUAGE_CODE=en
# Recipient format: 10-digit local (default) or intl (91XXXXXXXXXX)
# FOXGLOVE_WA_TO_FORMAT=intl

# --- 1) OTP on WhatsApp (utility / authentication template) ---
# Template name = lowercase_with_underscores as in Foxglove (e.g. otp_login)
FOXGLOVE_WA_OTP_TEMPLATE_NAME=your_otp_whatsapp_template
# Optional copy-code button on auth template
# FOXGLOVE_WA_OTP_BUTTON_ENABLED=true
# FOXGLOVE_WA_OTP_BUTTON_TYPE=copy_code

# --- 2) Appointment reminder on WhatsApp ---
# Body vars order: {{1}} patient, {{2}} doctor, {{3}} date, {{4}} time
FOXGLOVE_WA_APPOINTMENT_TEMPLATE_NAME=your_appointment_wa_template

# --- 3) Follow-up reminder on WhatsApp ---
FOXGLOVE_WA_FOLLOWUP_TEMPLATE_NAME=your_followup_wa_template

# --- 4) Payment link on WhatsApp (Razorpay collect payment) ---
# Body vars order: {{1}} patient, {{2}} amount, {{3}} invoice code, {{4}} payment link URL
FOXGLOVE_WA_PAYMENT_LINK_TEMPLATE_NAME=your_payment_link_wa_template

# --- 5) Prescription document on WhatsApp (header: PDF document) ---
# Header: document (PDF) | Body: {{1}} patient name, {{2}} prescription code/label
FOXGLOVE_WA_PRESCRIPTION_TEMPLATE_NAME=your_prescription_document_wa_template

# --- 6) Invoice / receipt on WhatsApp (header: PDF or JPG/PNG image) ---
# Header: document (PDF) or image (JPG/PNG) | Body: {{1}} patient, {{2}} invoice, {{3}} amount
FOXGLOVE_WA_INVOICE_TEMPLATE_NAME=your_invoice_document_wa_template

# Use mobile as WhatsApp fallback when whatsappNumber field is empty (default: true)
# FOXGLOVE_WA_USE_MOBILE_FALLBACK=false

# ═══════════════════════════════════════════════════════════════
# EMAIL — Nodemailer (same notifications as SMS + WhatsApp)
# Docs: BackEnd/docs/EMAIL_INTEGRATION.md
# Templates: BackEnd/src/services/email/templates/
# ═══════════════════════════════════════════════════════════════
MAIL_ENABLED=true
MAIL_HOST=smtp.zoho.in
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@yourdomain.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_NAME=Ayurveda Hospital
MAIL_FROM_EMAIL=your_email@yourdomain.com
HOSPITAL_NAME=Ayurveda Hospital
# MAIL_BCC=accounts@yourdomain.com
# MAIL_SUPPORT_EMAIL=support@yourdomain.com

# Per-type toggles (default: enabled when MAIL_* above is set)
# MAIL_OTP_ENABLED=false
# MAIL_APPOINTMENT_ENABLED=false
# MAIL_FOLLOWUP_ENABLED=false
# MAIL_PAYMENT_LINK_ENABLED=false
# MAIL_PRESCRIPTION_ENABLED=false
# MAIL_INVOICE_ENABLED=false

# Custom email subjects (optional — override defaults)
MAIL_OTP_SUBJECT=Your login OTP — Ayurveda HMS
MAIL_APPOINTMENT_SUBJECT=Appointment reminder
MAIL_FOLLOWUP_SUBJECT=Follow-up reminder
MAIL_PAYMENT_LINK_SUBJECT=Payment link for your invoice
MAIL_PRESCRIPTION_SUBJECT=Your prescription
MAIL_INVOICE_SUBJECT=Your invoice

# Legacy aliases (still supported): EMAIL, EMAIL_PASSWORD, BCC_EMAIL

# ═══════════════════════════════════════════════════════════════
# REMINDER JOB — when to send (applies to SMS + WhatsApp + Email)
# ═══════════════════════════════════════════════════════════════
SMS_REMINDER_ENABLED=true
SMS_REMINDER_MINUTES_BEFORE=60
SMS_REMINDER_WINDOW_MINUTES=2
SMS_REMINDER_POLL_INTERVAL_MS=60000

# Cloudinary (prescription PDFs — folder HMS/admin/{patient}/prescription)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ═══════════════════════════════════════════════════════════════
# GEMINI AI — Doctor consultation summary (medical assist)
# Get key: https://aistudio.google.com/apikey
# Full guide (free tier, tokens, pricing): BackEnd/docs/GEMINI_AI_CONSULTATION.md
# ═══════════════════════════════════════════════════════════════
GEMINI_ENABLED=true
GEMINI_API_KEY=
# gemini-3.5-flash = current free-tier model for new users | gemini-3.1-flash-lite = lighter/faster
GEMINI_MODEL=gemini-3.5-flash

# ═══════════════════════════════════════════════════════════════
# RAZORPAY — Online payments (billing)
# Dashboard: https://dashboard.razorpay.com/app/keys
# Webhook URL: POST {BACKEND_URL}/api/admin/billing/razorpay/webhook
# Webhook events: payment.captured, order.paid, qr_code.credited, payment_link.paid, payment.failed
# ═══════════════════════════════════════════════════════════════
RAZORPAY_ENABLED=true
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Run once after deploy or schema change (not needed on every dev restart):
# SYNC_RAZORPAY_INDEXES=true
# Full setup & testing guide: BackEnd/docs/RAZORPAY_BILLING_INTEGRATION.md
