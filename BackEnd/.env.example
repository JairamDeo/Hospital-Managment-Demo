PORT=5000
MONGO_URI=mongodb://localhost:27017/hospital_mgmt
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=24h
FRONTEND_URL=http://localhost:5173

# Admin seed
ADMIN_SEED_EMAIL=admin@ayurvedahealth.com
ADMIN_SEED_MOBILE=9876543210
ADMIN_SEED_PASSWORD=Admin@123

# OTP (forgot password)
STATIC_OTP=1122
OTP_EXPIRY_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=30

# MSG91 SMS — https://msg91.com/
MSG91_ENABLED=true
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_dlt_template_id
# Template variable name for OTP (must match your MSG91 template), e.g. OTP or VAR1
MSG91_OTP_VARIABLE=OTP

# Cloudinary (prescription PDFs — folder HMS/admin/{patient}/prescription)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
