PORT=5000
MONGO_URI=mongodb://localhost:27017/hospital_mgmt
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=24h
FRONTEND_URL=http://localhost:5173

# Admin seed
ADMIN_SEED_EMAIL=admin@ayurvedahealth.com
ADMIN_SEED_MOBILE=9876543210
ADMIN_SEED_PASSWORD=Admin@123

# OTP (forgot password)
STATIC_OTP=1122
OTP_EXPIRY_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=30

# ═══════════════════════════════════════════════════════════════
# MSG91 — SHARED (SMS + WhatsApp use the same auth key)
# ═══════════════════════════════════════════════════════════════
MSG91_ENABLED=true
MSG91_AUTH_KEY=your_msg91_auth_key

# ═══════════════════════════════════════════════════════════════
# 1) OTP — Forgot password / login OTP (SMS)
# ═══════════════════════════════════════════════════════════════
MSG91_TEMPLATE_ID=your_otp_dlt_template_id
MSG91_OTP_VARIABLE=OTP

# ═══════════════════════════════════════════════════════════════
# 2) APPOINTMENT REMINDER — ~1 hr before visit (SMS)
# ═══════════════════════════════════════════════════════════════
MSG91_APPOINTMENT_TEMPLATE_ID=your_appointment_dlt_template_id
MSG91_APPT_VAR_PATIENT=PATIENT
MSG91_APPT_VAR_DOCTOR=DOCTOR
MSG91_APPT_VAR_DATE=DATE
MSG91_APPT_VAR_TIME=TIME

# ═══════════════════════════════════════════════════════════════
# 3) FOLLOW-UP REMINDER — ~1 hr before follow-up (SMS)
# ═══════════════════════════════════════════════════════════════
MSG91_FOLLOWUP_TEMPLATE_ID=your_followup_dlt_template_id
MSG91_FOLLOWUP_VAR_PATIENT=PATIENT
MSG91_FOLLOWUP_VAR_DOCTOR=DOCTOR
MSG91_FOLLOWUP_VAR_DATE=DATE
MSG91_FOLLOWUP_VAR_TIME=TIME

# ═══════════════════════════════════════════════════════════════
# MSG91 WHATSAPP — same flows as SMS (separate approved templates)
# Dashboard: MSG91 → WhatsApp → integrate number → Sync templates
# Docs: BackEnd/docs/MSG91_WHATSAPP_INTEGRATION.md
# ═══════════════════════════════════════════════════════════════
MSG91_WA_ENABLED=true
# WhatsApp Business number integrated in MSG91 (digits only, e.g. 919876543210)
MSG91_WA_INTEGRATED_NUMBER=91XXXXXXXXXX
# Template namespace from MSG91 → WhatsApp → Templates → your template
MSG91_WA_NAMESPACE=your_waba_namespace_uuid
MSG91_WA_LANGUAGE_CODE=en

# --- 1) OTP on WhatsApp (utility / authentication template) ---
# Template name = approved name in Meta / MSG91 (not the SMS DLT id)
MSG91_WA_OTP_TEMPLATE_NAME=your_otp_whatsapp_template
# Component slot for OTP body, e.g. body_1 (see template variable order in MSG91)
MSG91_WA_OTP_VARIABLE=body_1
# Optional: copy OTP into URL button slot if your template has one
# MSG91_WA_OTP_BUTTON_VARIABLE=button_1

# --- 2) Appointment reminder on WhatsApp ---
MSG91_WA_APPOINTMENT_TEMPLATE_NAME=your_appointment_wa_template
MSG91_WA_APPT_VAR_PATIENT=body_1
MSG91_WA_APPT_VAR_DOCTOR=body_2
MSG91_WA_APPT_VAR_DATE=body_3
MSG91_WA_APPT_VAR_TIME=body_4

# --- 3) Follow-up reminder on WhatsApp ---
MSG91_WA_FOLLOWUP_TEMPLATE_NAME=your_followup_wa_template
MSG91_WA_FOLLOWUP_VAR_PATIENT=body_1
MSG91_WA_FOLLOWUP_VAR_DOCTOR=body_2
MSG91_WA_FOLLOWUP_VAR_DATE=body_3
MSG91_WA_FOLLOWUP_VAR_TIME=body_4

# ═══════════════════════════════════════════════════════════════
# REMINDER JOB — when to send (applies to SMS + WhatsApp)
# ═══════════════════════════════════════════════════════════════
SMS_REMINDER_ENABLED=true
SMS_REMINDER_MINUTES_BEFORE=60
SMS_REMINDER_WINDOW_MINUTES=2
SMS_REMINDER_POLL_INTERVAL_MS=60000

# Cloudinary (prescription PDFs — folder HMS/admin/{patient}/prescription)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
